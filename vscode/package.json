{
  "name": "edgar-spojenie",
  "displayName": "Edgar++",
  "description": "Sinkronizira lokalni C kod s Edgarovim uređivačem.",
  "version": "0.3.13",
  "publisher": "marroxo",
  "repository": {
    "type": "git",
    "url": "https://github.com/marroxo/edgar-plus-plus.git"
  },
  "bugs": {
    "url": "https://github.com/marroxo/edgar-plus-plus/issues"
  },
  "categories": [
    "Other"
  ],
  "files": [
    "extension.js"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:edgar.start",
    "onCommand:edgar.run",
    "onCommand:edgar.stop"
  ],
  "contributes": {
    "configuration": {
      "title": "Edgar++",
      "properties": {
        "edgar.chromeExtensionId": {
          "type": "string",
          "default": "",
          "scope": "application",
          "pattern": "^([a-p]{32})?$",
          "description": "ID pouzdanog primjerka Edgar++ iz chrome://extensions."
        }
      }
    },
    "commands": [
      {
        "command": "edgar.start",
        "title": "Edgar: Uključi povezivanje"
      },
      {
        "command": "edgar.run",
        "title": "Edgar: Pokreni provjeru"
      },
      {
        "command": "edgar.stop",
        "title": "Edgar: Isključi povezivanje"
      }
    ]
  }
}
