{
  "name": "edgar-spojenie",
  "displayName": "Edgar++",
  "description": "Sinkronizira lokalni C kod s Edgarovim uređivačem i pokreće lokalne provjere primjera.",
  "version": "0.3.10",
  "publisher": "marroxo",
  "repository": {
    "type": "git",
    "url": "https://github.com/marroxo/edgar-plus-plus.git"
  },
  "bugs": {
    "url": "https://github.com/marroxo/edgar-plus-plus/issues"
  },
  "categories": ["Other"],
  "files": ["extension.js", "local-panel.js", "local-tests.js"],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:edgar.start",
    "onCommand:edgar.run",
    "onCommand:edgar.stop",
    "onCommand:edgar.localTests"
  ],
  "contributes": {
    "commands": [
      {
        "command": "edgar.start",
        "title": "Edgar: Uključi povezivanje"
      },
      {
        "command": "edgar.run",
        "title": "Edgar: Pokreni provjeru"
      },
      {
        "command": "edgar.stop",
        "title": "Edgar: Isključi povezivanje"
      },
      {
        "command": "edgar.localTests",
        "title": "Edgar: Lokalno provjeri primjere"
      }
    ]
  }
}
